# Servidor
PORT=3000
NODE_ENV=production

# Supabase
SUPABASE_URL=https://xxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJxxxxxxxx...

# OpenAI
OPENAI_API_KEY=sk-proj-xxxxxxxx

# Redis (Upstash — grátis em upstash.com)
# Formato: rediss://default:SENHA@HOST:PORT
REDIS_URL=rediss://default:xxxxxx@global-xxxx.upstash.io:6379

# WhatsApp Cloud API (Meta)
# Obtenha em: https://developers.facebook.com → seu app → WhatsApp → API Setup
# WA_APP_SECRET é opcional (usado para verificar assinaturas dos webhooks)
WA_APP_SECRET=seu_app_secret_aqui

# Segurança do Webhook
# Deve coincidir com o "Verify Token" configurado no Meta Developer Console
WEBHOOK_VERIFY_TOKEN=webhook-secret-2024
WEBHOOK_SECRET=webhook-secret-2024

# URL do painel (para CORS)
PANEL_URL=https://seu-painel.vercel.app
